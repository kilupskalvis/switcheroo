#!/bin/sh
# Runs the switcheroo release this plugin version is pinned to, downloading it on first use.
# Bump version with every CLI release.
set -eu

version=v0.1.5
repo=kilupskalvis/switcheroo
dir=${XDG_CACHE_HOME:-$HOME/.cache}/switcheroo/bin/$version
bin=$dir/switcheroo

if [ ! -x "$bin" ]; then
  os=$(uname -s | tr '[:upper:]' '[:lower:]')
  case $os in
    linux | darwin) ;;
    *) echo "switcheroo: unsupported OS: $os" >&2; exit 1 ;;
  esac
  case $(uname -m) in
    x86_64 | amd64) arch=amd64 ;;
    arm64 | aarch64) arch=arm64 ;;
    *) echo "switcheroo: unsupported CPU: $(uname -m)" >&2; exit 1 ;;
  esac

  asset=switcheroo_${os}_${arch}.tar.gz
  url=https://github.com/$repo/releases/download/$version
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  echo "switcheroo: downloading $version" >&2
  curl -fsSL -o "$tmp/$asset" "$url/$asset"
  curl -fsSL -o "$tmp/checksums.txt" "$url/checksums.txt"
  if command -v sha256sum >/dev/null 2>&1; then sum="sha256sum"; else sum="shasum -a 256"; fi
  if ! (cd "$tmp" && grep " $asset\$" checksums.txt | $sum -c - >/dev/null); then
    echo "switcheroo: checksum mismatch for $asset" >&2
    exit 1
  fi
  tar -xzf "$tmp/$asset" -C "$tmp" switcheroo
  mkdir -p "$dir"
  mv -f "$tmp/switcheroo" "$bin"
  # Keep only this version.
  for old in "${dir%/*}"/*; do
    [ "$old" = "$dir" ] || rm -rf "$old"
  done
fi
exec "$bin" "$@"
